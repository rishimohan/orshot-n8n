{
	"name": "@thelifeofrishi/n8n-nodes-orshot",
	"version": "0.7.0",
	"description": "n8n node for Orshot: automate image, PDF and video generation from templates via API",
	"homepage": "https://orshot.com",
	"keywords": [
		"n8n-community-node-package",
		"image generation",
		"automated image generation",
		"pdf generation",
		"video generation",
		"template api"
	],
	"license": "MIT",
	"author": {
		"name": "Rishi Mohan",
		"email": "iamrishi.ms@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rishimohan/orshot-n8n.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist .tsbuildinfo && tsc && gulp build:icons && node scripts/verify-dist.js",
		"verify:dist": "node scripts/verify-dist.js",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "n8n-node lint",
		"lintfix": "n8n-node lint --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/OrshotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Orshot/Orshot.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.4",
		"@types/node": "^20.19.43",
		"eslint": "9.32.0",
		"gulp": "^5.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
